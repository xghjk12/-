{
  "name": "qingyin-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "轻音播放 —— 跑在浏览器里的本地音乐播放器",
  "scripts": {
    "dev": "vite",
    "dev:m0": "vite --config vite.m0.config.ts --port 5174 --strictPort",
    "build": "vite build",
    "build:m0": "vite build --config vite.m0.config.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check:bundle": "node scripts/check-browser-bundle.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm check:bundle"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "music-metadata": "^11.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
